# Serve sample data from src/lib/fixture-data.json instead of the studio server.
# The whole editor is usable this way no server, no models.
VITE_USE_FIXTURES=1

# Where to proxy /api, /media and /health when NOT using fixtures. The server
# prints its port on stdout as {"status":"ready","port":N}; set this to match.
# VITE_SERVER_URL=http://127.0.0.1:8756
