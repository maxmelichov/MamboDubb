# Copy to .env and fill in. Never commit real tokens.
#
# NOTHING HERE IS REQUIRED. A fresh machine runs the whole pipeline with no
# credentials: every model it opens is a public repo, diarization included.
#
# HF_TOKEN is only useful together with DUB_DIARIZATION_HUB below, to fetch the
# gated upstream diarization pipeline instead of the ungated mirror of the same
# CC-BY-4.0 weights. Create one at https://huggingface.co/settings/tokens and
# accept the terms on https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Where the diarization pipeline is loaded from: a Hugging Face repo id, or a
# local directory. Unset (the default) means models/speaker-diarization-community-1
# if it is installed, otherwise the mirror named by segments.DIARIZATION_MIRROR.
# DUB_DIARIZATION_HUB=pyannote/speaker-diarization-community-1
